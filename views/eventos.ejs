<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Eventos</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="container">
    <h1>Eventos</h1>

    <table>
      <tr>
        <th>ID</th>
        <th>Partida</th>
        <th>Jogador</th>
        <th>Tipo</th>
        <th>Minuto</th>
        <th>Observação</th>
      </tr>

      <% eventos.forEach(e => { %>
        <tr>
          <td><%= e.id %></td>
          <td><%= e.partida %></td>
          <td><%= e.jogador %></td>
          <td><%= e.tipoEvento %></td>
          <td><%= e.minuto %></td>
          <td><%= e.observacao %></td>
        </tr>
      <% }) %>
    </table>

    <div class="actions">
      <a class="voltar" href="/">Voltar</a>
    </div>
  </div>
</body>
</html>